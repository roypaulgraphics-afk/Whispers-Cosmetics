# ---------------------------------------------------------------------------
# Whispers Cosmetics POS - environment configuration
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0

# Where the SQLite database, uploads and backups live.
# In Docker this is /data (mounted volume).
DATA_DIR=./data

# Business timezone used for daily reports and stock movements.
STORE_TIMEZONE=Africa/Nairobi

# Import data/whispers_db.json on first run when the store is empty.
SEED_LEGACY=true

# Name printed as the cashier on receipts and the audit trail.
CASHIER_NAME=Main Register

# Set to true only when running behind a reverse proxy (nginx, Caddy, Traefik).
TRUST_PROXY=false

# Set to true when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# How long a cashier stays signed in.
SESSION_DAYS=7

# Development only: set true to disable Vite HMR when using a custom host.
DISABLE_HMR=false

# Public URL of the store server, e.g. https://pos.whispers.co.ke
# Used to derive the M-Pesa callback URL when MPESA_CALLBACK_URL is not set.
APP_URL=

# ---------------------------------------------------------------------------
# M-Pesa Daraja (optional)
# Leave the credentials blank to run with manual M-Pesa confirmation codes
# only (cashier types the code from the customer's SMS).
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Either set the full callback URL, or set APP_URL + a random secret:
#   <APP_URL>/api/mpesa/callback/<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# Allow cashiers to record M-Pesa payments from the confirmation SMS when
# Daraja is unavailable or not configured.
MANUAL_MPESA_ENABLED=true
